# Public browser configuration. These are publishable values, never service-role keys.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_key

# Server-only Alibaba Cloud Model Studio credentials. Do not prefix these with VITE_.
DASHSCOPE_API_KEY=replace_with_server_only_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_ASR_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_EVALUATION_MODEL=qwen3.5-plus
DASHSCOPE_SCENARIO_MODEL=qwen3.7-plus
DASHSCOPE_CAREER_REPORT_MODEL=qwen3.5-plus

# Server-side Supabase verification configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_public_key
